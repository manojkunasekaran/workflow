FROM maven:3.9-eclipse-temurin-21-alpine

WORKDIR /app

# Expose the application port and debug port
EXPOSE 8080 8000

# Copy project definition files first to cache dependencies
COPY pom.xml .
COPY api/pom.xml api/
COPY core/pom.xml core/
COPY common/pom.xml common/
COPY persistence/pom.xml persistence/

# Download dependencies (this layer will be cached unless poms change)
RUN mvn dependency:go-offline -B

# Run the application with DevTools and remote debugging enabled
# We use the exec form to ensure signals are passed correctly
CMD ["mvn", "spring-boot:run", "-pl", "api", "-am", "-Dspring-boot.run.jvmArguments=-agentlib:jdwp=transport=dt_socket,server=y,suspend=n,address=*:8000", "-Dspring-boot.run.profiles=dev", "-Dspring.devtools.restart.enabled=true"]
