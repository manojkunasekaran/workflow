# ── IDE & editor artefacts ────────────────────────────────────────────────────
.idea/
.vscode/
*.iml
*.iws
*.ipr
.settings/
.classpath
.project

# ── Version control ───────────────────────────────────────────────────────────
.git/
.gitignore
.github/

# ── Maven wrapper (not needed inside container) ───────────────────────────────
.mvn/
mvnw
mvnw.cmd

# ── Logs & OS noise ───────────────────────────────────────────────────────────
*.log
*.DS_Store
Thumbs.db

# ── Documentation ─────────────────────────────────────────────────────────────
*.md
docs/

# NOTE: target/ directories are intentionally NOT excluded here.
# The IDE compiles on the host and writes to target/; those compiled classes
# are volume-mounted into the container so mvn spring-boot:run can use them
# without recompiling.  Docker-anonymous volumes shadow the specific target/
# paths in docker-compose.yml to avoid Windows file-lock conflicts.
