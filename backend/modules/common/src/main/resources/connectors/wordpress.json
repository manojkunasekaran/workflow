    "credentialGuide": {
        "description": "Duplicate the app and set baseUrl to your site REST URL (https://YOUR_SITE/wp-json/wp/v2). Use Application Passwords (Basic Auth) or clone with BEARER_TOKEN for JWT plugins.",
        "fields": [
            {
                "key": "username",
                "label": "WordPress Username",
                "hint": "Users \u2192 Profile \u2192 Application Passwords"
            },
            {
                "key": "password",
                "label": "Application Password",
                "hint": "Generated application password (not your login password)"
            },
            {
                "key": "baseUrl",
                "label": "Site Base URL",
                "hint": "Set to https://YOUR_SITE/wp-json/wp/v2 when cloning"
            }
        ]
    },
