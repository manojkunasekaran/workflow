            "path": "/workspaces",
            "inputSchema": [],
            "outputPaths": [
                "values"
            ]
        },
        {
            "actionId": "list_repositories",
            "displayName": "List Repositories",
            "method": "GET",
            "path": "/repositories/{workspace}",
            "inputSchema": [
                {
                    "key": "workspace",
                    "label": "Workspace",
                    "type": "STRING",
                    "required": true,
                    "supportsExpression": true
                }
            ],
            "pathParams": [
                "workspace"
            ],
            "outputPaths": [
                "values"
            ]
        },
        {
            "actionId": "get_repository",
            "displayName": "Get Repository",
            "method": "GET",
            "path": "/repositories/{workspace}/{repo_slug}",
            "inputSchema": [
                {
                    "key": "workspace",
                    "label": "Workspace",
                    "type": "STRING",
                    "required": true,
                    "supportsExpression": true
                },
                {
                    "key": "repo_slug",
                    "label": "Repo Slug",
                    "type": "STRING",
                    "required": true,
                    "supportsExpression": true
                }
            ],
            "pathParams": [
                "workspace",
                "repo_slug"
            ],
            "outputPaths": [
                "$"
            ]
        },
        {
            "actionId": "create_repository",
            "displayName": "Create Repository",
            "method": "POST",
            "path": "/repositories/{workspace}/{repo_slug}",
            "inputSchema": [
                {
                    "key": "workspace",
                    "label": "Workspace",
                    "type": "STRING",
                    "required": true,
                    "supportsExpression": true
                },
                {
                    "key": "repo_slug",
                    "label": "Repo Slug",
                    "type": "STRING",
                    "required": true,
                    "supportsExpression": true
                },
                {
                    "key": "is_private",
                    "label": "Private",
                    "type": "STRING",
                    "required": false,
                    "supportsExpression": true,
                    "defaultValue": "true"
                }
            ],
            "pathParams": [
                "workspace",
                "repo_slug"
            ],
            "inputScript": "return {scm:'git',is_private:$inputs.is_private!=='false'};",
            "fixedHeaders": {
                "Content-Type": "application/json"
            },
            "outputPaths": [
                "uuid"
            ]
        },
        {
            "actionId": "list_pullrequests",
