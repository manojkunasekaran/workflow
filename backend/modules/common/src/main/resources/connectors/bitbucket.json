            "actionId": "create_pullrequest",
            "displayName": "Create Pull Request",
            "method": "POST",
            "path": "/repositories/{workspace}/{repo_slug}/pullrequests",
            "inputSchema": [
                {
                    "key": "workspace",
                    "label": "Workspace",
                    "type": "STRING",
                    "required": true,
                    "supportsExpression": true
                },
                {
                    "key": "repo_slug",
                    "label": "Repo Slug",
                    "type": "STRING",
                    "required": true,
                    "supportsExpression": true
                },
                {
                    "key": "title",
                    "label": "Title",
                    "type": "STRING",
                    "required": true,
                    "supportsExpression": true
                },
                {
                    "key": "source_branch",
                    "label": "Source Branch",
                    "type": "STRING",
                    "required": true,
                    "supportsExpression": true
                },
                {
                    "key": "destination_branch",
                    "label": "Destination Branch",
                    "type": "STRING",
                    "required": true,
                    "supportsExpression": true
                }
            ],
            "pathParams": [
                "workspace",
                "repo_slug"
            ],
            "inputScript": "return {title:$inputs.title,source:{branch:{name:$inputs.source_branch}},destination:{branch:{name:$inputs.destination_branch}}};",
            "fixedHeaders": {
                "Content-Type": "application/json"
            },
            "outputPaths": [
                "id"
            ]
        },
