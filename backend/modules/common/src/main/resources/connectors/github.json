{
  "connectorId": "github",
  "displayName": "GitHub",
  "icon": "https://cdn.iconscout.com/icon/free/png-256/github-1521488-1288230.png",
  "category": "Productivity",
  "baseUrl": "https://api.github.com",
  "authType": "BEARER_TOKEN",
  "credentialGuide": {
    "fields": [
      {
        "key": "token",
        "label": "Personal Access Token",
        "hint": "Generate in Developer Settings"
      }
    ]
  },
  "actions": [
    {
      "actionId": "create_issue",
      "displayName": "Create Issue",
      "method": "POST",
      "path": "/repos/{owner}/{repo}/issues",
      "pathParams": [
        "owner",
        "repo"
      ],
      "inputSchema": [
        {
          "key": "owner",
          "label": "Owner",
          "type": "STRING",
          "required": true,
          "supportsExpression": true
        },
        {
          "key": "repo",
          "label": "Repository",
          "type": "STRING",
          "required": true,
          "supportsExpression": true
        },
        {
          "key": "title",
          "label": "Title",
          "type": "STRING",
          "required": true,
          "supportsExpression": true
        },
        {
          "key": "body",
          "label": "Body",
          "type": "TEXTAREA",
          "required": false,
          "supportsExpression": true
        }
      ],
      "inputScript": "return { title: $inputs.title, body: $inputs.body };",
      "outputPaths": [
        "id",
        "number",
        "html_url"
      ]
    }
  ]
}