{
    "connectorId": "trello",
    "displayName": "Trello",
    "icon": "https://api.iconify.design/logos/trello.svg",
    "category": "Project Management",
    "taskType": "CONNECTOR_TASK",
    "baseUrl": "https://api.trello.com/1",
    "authType": "BEARER_TOKEN",
    "credentialGuide": {
        "description": "Trello uses an API Key and User Token. Use BEARER_TOKEN with the user token, or clone this connector with authType CUSTOM_HEADER and store key/token as header fields. Query-string auth: set baseUrl to https://api.trello.com/1?key=YOUR_KEY and use BEARER for the token.",
        "fields": [
            {
                "key": "apiKey",
                "label": "API Key",
                "hint": "From https://trello.com/power-ups/admin",
                "docUrl": "https://developer.atlassian.com/cloud/trello/guides/rest-api/api-introduction/"
            },
            {
                "key": "token",
                "label": "User Token",
                "hint": "Generate via Trello authorize URL with your API key"
            }
        ]
    },
    "connectionSetup": {
        "fields": [
            {
                "label": "API Key",
                "key": "apiKey",
                "sensitive": false
            },
            {
                "label": "User Token",
                "key": "token",
                "sensitive": true
            }
        ]
    },
    "verifyAction": {
        "method": "GET",
        "path": "/members/me"
    },
    "actions": [
        {
            "actionId": "list_boards",
            "displayName": "List Boards",
            "method": "GET",
            "path": "/members/me/boards",
            "inputSchema": [
                {
                    "key": "limit",
                    "label": "Limit",
                    "type": "NUMBER",
                    "required": false,
                    "supportsExpression": true,
                    "defaultValue": 50
                }
            ],
            "outputPaths": [
                "$"
            ]
        },
        {
            "actionId": "get_board",
            "displayName": "Get Board",
            "method": "GET",
            "path": "/boards/{boardId}",
            "inputSchema": [
                {
                    "key": "boardId",
                    "label": "Board ID",
                    "type": "STRING",
                    "required": true,
                    "supportsExpression": true
                }
            ],
            "pathParams": [
                "boardId"
            ],
            "outputPaths": [
                "id"
            ]
        },
        {
            "actionId": "create_board",
            "displayName": "Create Board",
            "method": "POST",
            "path": "/boards",
            "inputSchema": [
                {
                    "key": "name",
                    "label": "Name",
                    "type": "STRING",
                    "required": true,
                    "supportsExpression": true
                },
                {
                    "key": "desc",
                    "label": "Description",
                    "type": "TEXTAREA",
                    "required": false,
                    "supportsExpression": true
                },
                {
                    "key": "defaultLists",
                    "label": "Create Default Lists",
                    "type": "BOOLEAN",
                    "required": false,
                    "supportsExpression": true,
                    "defaultValue": true
                }
            ],
            "inputScript": "return {name:$inputs.name, desc:$inputs.desc||'', defaultLists:$inputs.defaultLists!==false};",
            "fixedHeaders": {
                "Content-Type": "application/json"
            },
            "outputPaths": [
                "id"
            ]
        },
        {
            "actionId": "update_board",
            "displayName": "Update Board",
            "method": "PUT",
            "path": "/boards/{boardId}",
            "inputSchema": [
                {
                    "key": "boardId",
                    "label": "Board ID",
                    "type": "STRING",
                    "required": true,
                    "supportsExpression": true
                },
                {
                    "key": "name",
                    "label": "Name",
                    "type": "STRING",
                    "required": false,
                    "supportsExpression": true
                },
                {
                    "key": "desc",
                    "label": "Description",
                    "type": "TEXTAREA",
                    "required": false,
                    "supportsExpression": true
                },
                {
                    "key": "closed",
                    "label": "Closed",
                    "type": "BOOLEAN",
                    "required": false,
                    "supportsExpression": true
                }
            ],
            "pathParams": [
                "boardId"
            ],
            "inputScript": "const b={}; if($inputs.name) b.name=$inputs.name; if($inputs.desc!=null) b.desc=$inputs.desc; if($inputs.closed!=null) b.closed=$inputs.closed; return b;",
            "fixedHeaders": {
                "Content-Type": "application/json"
            },
            "outputPaths": [
                "id"
            ]
        },
        {
            "actionId": "delete_board",
