            ],
            "inputScript": "const b={name:$inputs.name,idList:$inputs.idList}; if($inputs.desc) b.desc=$inputs.desc; if($inputs.idMembers) b.idMembers=$inputs.idMembers.split(',').map(s=>s.trim()); return b;",
            "fixedHeaders": {
