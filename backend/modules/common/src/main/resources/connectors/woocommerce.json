{
    "connectorId": "woocommerce",
    "displayName": "WooCommerce",
    "icon": "https://api.iconify.design/logos/woocommerce.svg",
    "category": "E-commerce",
    "taskType": "CONNECTOR_TASK",
    "baseUrl": "https://example.com/wp-json/wc/v3",
    "authType": "BASIC_AUTH",
    "credentialGuide": {
        "description": "Duplicate the app and set baseUrl to your store REST URL (https://YOUR_SITE/wp-json/wc/v3). Use Basic Auth with WooCommerce REST API keys, or clone with BEARER_TOKEN for JWT plugins.",
        "fields": [
            {
                "key": "username",
                "label": "Consumer Key",
                "hint": "WooCommerce \u2192 Settings \u2192 Advanced \u2192 REST API"
            },
            {
                "key": "password",
                "label": "Consumer Secret",
                "hint": "Shown once when the REST key is created"
            },
            {
                "key": "baseUrl",
                "label": "Store Base URL",
                "hint": "Set to https://YOUR_SITE/wp-json/wc/v3 when cloning"
            }
        ]
    },
    "connectionSetup": {
        "fields": [
            {
                "label": "Consumer Key",
                "key": "username",
                "sensitive": false
            },
            {
                "label": "Consumer Secret",
                "key": "password",
                "sensitive": true
            }
        ]
    },
    "verifyAction": {
        "method": "GET",
        "path": "/system_status"
    },
    "actions": [
        {
            "actionId": "list_products",
            "displayName": "List Products",
            "method": "GET",
            "path": "/products",
            "inputSchema": [
                {
                    "key": "limit",
                    "label": "Limit",
                    "type": "NUMBER",
                    "required": false,
                    "supportsExpression": true,
                    "defaultValue": 50
                }
            ],
            "outputPaths": [
                "$"
            ]
        },
        {
            "actionId": "get_product",
            "displayName": "Get Product",
            "method": "GET",
            "path": "/products/{productId}",
            "inputSchema": [
                {
                    "key": "productId",
                    "label": "Product ID",
                    "type": "NUMBER",
                    "required": true,
                    "supportsExpression": true
                }
            ],
            "pathParams": [
                "productId"
            ],
            "outputPaths": [
                "id"
            ]
        },
        {
            "actionId": "create_product",
            "displayName": "Create Product",
            "method": "POST",
            "path": "/products",
            "inputSchema": [
                {
                    "key": "name",
                    "label": "Name",
                    "type": "STRING",
                    "required": true,
                    "supportsExpression": true
                },
                {
                    "key": "type",
                    "label": "Type",
                    "type": "STRING",
                    "required": false,
                    "supportsExpression": true,
                    "defaultValue": "simple"
                },
                {
                    "key": "regular_price",
                    "label": "Regular Price",
                    "type": "STRING",
                    "required": false,
                    "supportsExpression": true
                }
            ],
            "inputScript": "const b={name:$inputs.name,type:$inputs.type||'simple'}; if($inputs.regular_price) b.regular_price=$inputs.regular_price; return b;",
            "fixedHeaders": {
                "Content-Type": "application/json"
            },
            "outputPaths": [
                "id"
            ]
        },
        {
            "actionId": "update_product",
            "displayName": "Update Product",
            "method": "PUT",
            "path": "/products/{productId}",
            "inputSchema": [
                {
                    "key": "productId",
                    "label": "Product ID",
                    "type": "NUMBER",
                    "required": true,
                    "supportsExpression": true
                },
                {
                    "key": "name",
                    "label": "Name",
                    "type": "STRING",
                    "required": false,
                    "supportsExpression": true
                },
                {
                    "key": "regular_price",
                    "label": "Regular Price",
                    "type": "STRING",
                    "required": false,
                    "supportsExpression": true
                },
                {
                    "key": "status",
                    "label": "Status",
                    "type": "STRING",
                    "required": false,
                    "supportsExpression": true
                }
            ],
            "pathParams": [
                "productId"
            ],
            "inputScript": "const b={}; if($inputs.name) b.name=$inputs.name; if($inputs.regular_price) b.regular_price=$inputs.regular_price; if($inputs.status) b.status=$inputs.status; return b;",
            "fixedHeaders": {
                "Content-Type": "application/json"
            },
            "outputPaths": [
                "id"
            ]
        },
        {
            "actionId": "delete_product",
            "displayName": "Delete Product",
            "method": "DELETE",
            "path": "/products/{productId}",
            "inputSchema": [
                {
                    "key": "productId",
                    "label": "Product ID",
                    "type": "NUMBER",
                    "required": true,
                    "supportsExpression": true
                }
            ],
            "pathParams": [
                "productId"
            ],
            "outputPaths": [
                "id"
            ]
        },
