{
  "connectorId": "openai",
  "displayName": "OpenAI",
  "icon": "https://cdn.iconscout.com/icon/free/png-256/openai-3628861-3030001.png",
  "category": "AI",
  "baseUrl": "https://api.openai.com/v1",
  "authType": "BEARER_TOKEN",
  "credentialGuide": {
    "fields": [
      {
        "key": "token",
        "label": "API Key",
        "hint": "Starts with sk-"
      }
    ]
  },
  "actions": [
    {
      "actionId": "create_completion",
      "displayName": "Create Chat Completion",
      "method": "POST",
      "path": "/chat/completions",
      "inputSchema": [
        {
          "key": "model",
          "label": "Model",
          "type": "STRING",
          "required": true,
          "defaultValue": "gpt-4o",
          "supportsExpression": true
        },
        {
          "key": "prompt",
          "label": "Prompt",
          "type": "TEXTAREA",
          "required": true,
          "supportsExpression": true
        }
      ],
      "inputScript": "return { model: $inputs.model, messages: [{ role: 'user', content: $inputs.prompt }] };",
      "outputPaths": [
        "choices.0.message.content"
      ]
    }
  ]
}