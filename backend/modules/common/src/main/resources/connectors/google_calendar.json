{
  "connectorId": "google_calendar",
  "displayName": "Google Calendar",
  "icon": "https://cdn.iconscout.com/icon/free/png-256/google-calendar-3628861-3030001.png",
  "category": "Calendar",
  "baseUrl": "https://www.googleapis.com/calendar/v3",
  "authType": "OAUTH2",
  "oauth2Config": {
    "authorizationUrl": "https://accounts.google.com/o/oauth2/auth",
    "tokenUrl": "https://oauth2.googleapis.com/token",
    "defaultScopes": [
      "https://www.googleapis.com/auth/calendar.events"
    ]
  },
  "actions": [
    {
      "actionId": "create_event",
      "displayName": "Create Event",
      "method": "POST",
      "path": "/calendars/{calendarId}/events",
      "pathParams": [
        "calendarId"
      ],
      "inputSchema": [
        {
          "key": "calendarId",
          "label": "Calendar ID",
          "type": "STRING",
          "required": true,
          "defaultValue": "primary",
          "supportsExpression": true
        },
        {
          "key": "summary",
          "label": "Event Title",
          "type": "STRING",
          "required": true,
          "supportsExpression": true
        },
        {
          "key": "startTime",
          "label": "Start Time (ISO8601)",
          "type": "STRING",
          "required": true,
          "supportsExpression": true
        },
        {
          "key": "endTime",
          "label": "End Time (ISO8601)",
          "type": "STRING",
          "required": true,
          "supportsExpression": true
        }
      ],
      "inputScript": "return { summary: $inputs.summary, start: { dateTime: $inputs.startTime }, end: { dateTime: $inputs.endTime } };",
      "outputPaths": [
        "id",
        "htmlLink"
      ]
    }
  ]
}