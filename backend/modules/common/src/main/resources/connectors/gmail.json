    "actions":  [
                    {
                        "actionId":  "send_email",
                        "displayName":  "Send Email",
                        "method":  "POST",
                        "path":  "/messages/send",
                        "inputScript":  "let to = $input.to;\nlet subject = $input.subject;\nlet body = $input.body;\nlet from = $input.from || \u0027\u0027;\nlet cc = $input.cc || \u0027\u0027;\nlet bcc = $input.bcc || \u0027\u0027;\nlet isHtml = $input.bodyIsHtml === true || $input.bodyIsHtml === \u0027true\u0027;\n\nif (!to || !subject || !body) throw new Error(\u0027To, Subject, and Body are required\u0027);\n\nlet mime = [];\nmime.push(\u0027Date: \u0027 + new Date().toUTCString());\nif (from) mime.push(\u0027From: \u0027 + from);\nmime.push(\u0027To: \u0027 + to);\nif (cc) mime.push(\u0027Cc: \u0027 + cc);\nif (bcc) mime.push(\u0027Bcc: \u0027 + bcc);\nmime.push(\u0027Subject: \u0027 + subject);\nmime.push(\u0027MIME-Version: 1.0\u0027);\nmime.push(\u0027Content-Type: \u0027 + (isHtml ? \u0027text/html; charset=UTF-8\u0027 : \u0027text/plain; charset=UTF-8\u0027));\nmime.push(\u0027\u0027);\nmime.push(body);\n\nreturn { raw: $helpers.base64UrlEncode(mime.join(\u0027\\r\\n\u0027)) };",
                        "fixedHeaders":  {
                                             "Content-Type":  "application/json"
                                         },
                        "inputSchema":  [
                                            {
                                                "key":  "to",
                                                "label":  "To",
                                                "type":  "STRING",
                                                "required":  true,
                                                "supportsExpression":  true,
                                                "placeholder":  "recipient@example.com (comma-separated for multiple)"
                                            },
                                            {
                                                "key":  "subject",
                                                "label":  "Subject",
                                                "type":  "STRING",
                                                "required":  true,
                                                "supportsExpression":  true
                                            },
                                            {
                                                "key":  "body",
                                                "label":  "Body",
                                                "type":  "TEXTAREA",
                                                "required":  true,
                                                "supportsExpression":  true
                                            },
                                            {
                                                "key":  "from",
                                                "label":  "From (optional override)",
                                                "type":  "STRING",
                                                "required":  false,
                                                "supportsExpression":  true,
                                                "placeholder":  "Your Name \u003cyou@gmail.com\u003e",
                                                "description":  "Defaults to authenticated Gmail account if omitted."
                                            },
                                            {
                                                "key":  "cc",
                                                "label":  "CC",
                                                "type":  "STRING",
                                                "required":  false,
                                                "supportsExpression":  true
                                            },
                                            {
                                                "key":  "bcc",
                                                "label":  "BCC",
                                                "type":  "STRING",
                                                "required":  false,
                                                "supportsExpression":  true
                                            },
                                            {
                                                "key":  "bodyIsHtml",
                                                "label":  "Send as HTML",
                                                "type":  "BOOLEAN",
                                                "required":  false,
                                                "supportsExpression":  false,
                                                "defaultValue":  false
                                            }
                                        ],
                        "outputPaths":  [
                                            "id",
                                            "threadId",
                                            "labelIds"
                                        ]
                    },
                    {
                        "actionId":  "get_profile",
