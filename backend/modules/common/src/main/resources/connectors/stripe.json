{
    "connectorId": "stripe",
    "displayName": "Stripe",
    "icon": "https://api.iconify.design/logos/stripe.svg",
    "category": "Payments",
    "taskType": "CONNECTOR_TASK",
    "baseUrl": "https://api.stripe.com/v1",
    "authType": "BEARER_TOKEN",
    "credentialGuide": {
        "fields": [
            {
                "key": "token",
                "label": "Secret Key",
                "hint": "Starts with sk_live_ or sk_test_"
            }
        ]
    },
    "actions": [
        {
            "actionId": "create_customer",
            "displayName": "Create Customer",
            "method": "POST",
            "path": "/customers",
            "inputSchema": [
                {
                    "key": "email",
                    "label": "Email",
                    "type": "STRING",
                    "required": true,
                    "supportsExpression": true
                },
                {
                    "key": "name",
                    "label": "Name",
                    "type": "STRING",
                    "required": false,
                    "supportsExpression": true
                }
            ],
            "inputScript": "return { email: $inputs.email, name: $inputs.name };",
            "outputPaths": [
                "id",
                "email"
            ]
        },
        {
            "actionId": "get_customer",
            "displayName": "Get Customer",
            "method": "GET",
            "path": "/customers/{customerId}",
            "pathParams": [
                "customerId"
            ],
            "inputSchema": [
                {
                    "key": "customerId",
                    "label": "Customer ID",
                    "type": "STRING",
                    "required": true,
                    "supportsExpression": true
                }
            ],
            "outputPaths": [
                "id",
                "email",
                "name"
            ]
        },
        {
            "actionId": "list_customers",
            "displayName": "List Customers",
            "method": "GET",
            "path": "/customers",
            "inputSchema": [
                {
                    "key": "limit",
                    "label": "Limit",
                    "type": "NUMBER",
                    "required": false,
                    "supportsExpression": true,
                    "defaultValue": 10
                },
                {
                    "key": "email",
                    "label": "Email",
                    "type": "STRING",
                    "required": false,
                    "supportsExpression": true
                }
            ],
            "outputPaths": [
                "data",
                "has_more"
            ]
        },
        {
            "actionId": "create_charge",
            "displayName": "Create Charge",
            "method": "POST",
            "path": "/charges",
            "inputSchema": [
                {
                    "key": "amount",
                    "label": "Amount (in cents)",
                    "type": "NUMBER",
                    "required": true,
                    "supportsExpression": true
                },
                {
                    "key": "currency",
                    "label": "Currency",
                    "type": "STRING",
                    "required": true,
                    "defaultValue": "usd",
                    "supportsExpression": true
                },
                {
                    "key": "customer",
                    "label": "Customer ID",
                    "type": "STRING",
                    "required": false,
                    "supportsExpression": true
                },
                {
                    "key": "source",
                    "label": "Source (Token or Card ID)",
                    "type": "STRING",
                    "required": false,
                    "supportsExpression": true
                }
            ],
            "inputScript": "let body = { amount: $inputs.amount, currency: $inputs.currency }; if ($inputs.customer) body.customer = $inputs.customer; if ($inputs.source) body.source = $inputs.source; return body;",
            "outputPaths": [
                "id",
                "amount",
                "status"
            ]
        },
        {
            "actionId": "create_invoice",
            "displayName": "Create Invoice",
            "method": "POST",
            "path": "/invoices",
            "inputSchema": [
                {
                    "key": "customer",
                    "label": "Customer ID",
                    "type": "STRING",
                    "required": true,
                    "supportsExpression": true
                },
                {
                    "key": "description",
                    "label": "Description",
                    "type": "STRING",
                    "required": false,
                    "supportsExpression": true
                }
            ],
            "inputScript": "let body = { customer: $inputs.customer }; if ($inputs.description) body.description = $inputs.description; return body;",
            "outputPaths": [
                "id",
                "status",
                "customer"
            ]
        }
    ],
    "connectionSetup": {
        "fields": [
            {
                "label": "Secret Key",
                "key": "token",
                "sensitive": true,
                "hint": "Starts with sk_live_ or sk_test_"
            }
        ]
    },
    "verifyAction": {
        "method": "GET",
        "path": "/"
    }
}
