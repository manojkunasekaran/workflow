                        "pathParams":  [
                                           "token"
                                       ],
                        "fixedHeaders":  {
                                             "Content-Type":  "application/json"
                                         },
                        "inputSchema":  [
                                            {
                                                "key":  "token",
                                                "label":  "Bot Token",
                                                "type":  "STRING",
                                                "required":  true,
                                                "supportsExpression":  true
                                            },
                                            {
                                                "key":  "chat_id",
                                                "label":  "Chat ID",
                                                "type":  "STRING",
                                                "required":  true,
                                                "supportsExpression":  true
                                            },
                                            {
