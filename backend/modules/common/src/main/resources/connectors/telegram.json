                                            {
                                                "key":  "parse_mode",
                                                "label":  "Parse Mode",
                                                "type":  "SELECT",
                                                "required":  false,
                                                "supportsExpression":  false,
                                                "defaultValue":  "Markdown",
                                                "options":  [
                                                                {
                                                                    "label":  "Markdown",
                                                                    "value":  "Markdown"
                                                                },
                                                                {
                                                                    "label":  "HTML",
                                                                    "value":  "HTML"
                                                                },
                                                                {
                                                                    "label":  "None",
                                                                    "value":  ""
                                                                }
                                                            ]
                                            },
                                            {
                                                "key":  "disable_notification",
                                                "label":  "Silent Message",
                                                "type":  "BOOLEAN",
                                                "required":  false,
                                                "supportsExpression":  false
                                            }
                                        ],
                        "outputPaths":  [
                                            "ok",
                                            "result.message_id",
                                            "result.text"
                                        ]
                    },
