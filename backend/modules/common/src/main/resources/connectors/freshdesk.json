                {
                    "key": "status",
                    "label": "Status",
                    "type": "NUMBER",
                    "required": false,
                    "supportsExpression": true
                },
                {
                    "key": "priority",
                    "label": "Priority",
                    "type": "NUMBER",
                    "required": false,
                    "supportsExpression": true
                }
            ],
            "pathParams": [
                "ticket_id"
            ],
            "inputScript": "const b={}; if($inputs.status!=null) b.status=Number($inputs.status); if($inputs.priority!=null) b.priority=Number($inputs.priority); return b;",
            "fixedHeaders": {
                "Content-Type": "application/json"
            },
            "outputPaths": [
                "id"
            ]
        },
