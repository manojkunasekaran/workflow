        },
        {
            "actionId": "create_ticket",
            "displayName": "Create Ticket",
            "method": "POST",
            "path": "/tickets",
            "inputSchema": [
                {
                    "key": "subject",
                    "label": "Subject",
                    "type": "STRING",
                    "required": true,
                    "supportsExpression": true
                },
                {
                    "key": "description",
                    "label": "Description",
                    "type": "TEXTAREA",
                    "required": true,
                    "supportsExpression": true
                },
                {
                    "key": "email",
                    "label": "Requester Email",
                    "type": "STRING",
                    "required": true,
                    "supportsExpression": true
                },
                {
                    "key": "priority",
                    "label": "Priority",
                    "type": "STRING",
                    "required": false,
                    "supportsExpression": true,
                    "defaultValue": "1"
                }
            ],
            "inputScript": "return {subject:$inputs.subject,description:$inputs.description,email:$inputs.email,priority:Number($inputs.priority||1)};",
            "fixedHeaders": {
                "Content-Type": "application/json"
            },
            "outputPaths": [
                "id"
            ]
        },
        {
            "actionId": "update_ticket",
            "displayName": "Update Ticket",
            "method": "PUT",
            "path": "/tickets/{ticket_id}",
            "inputSchema": [
                {
                    "key": "ticket_id",
                    "label": "Ticket ID",
                    "type": "NUMBER",
                    "required": true,
                    "supportsExpression": true
