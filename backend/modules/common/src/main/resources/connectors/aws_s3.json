{
  "connectorId": "aws_s3",
  "displayName": "AWS S3",
  "icon": "https://cdn.iconscout.com/icon/free/png-256/aws-3628861-3030001.png",
  "category": "Cloud Storage",
  "baseUrl": "https://{bucket}.s3.{region}.amazonaws.com",
  "authType": "CUSTOM_HEADER",
  "credentialGuide": {
    "fields": [
      {
        "key": "x-amz-security-token",
        "label": "Session Token",
        "hint": "For simplicity in this stub, you can put presigned auth headers here."
      }
    ]
  },
  "actions": [
    {
      "actionId": "put_object",
      "displayName": "Upload File (Stub)",
      "method": "PUT",
      "path": "/{key}",
      "pathParams": [
        "bucket",
        "region",
        "key"
      ],
      "inputSchema": [
        {
          "key": "bucket",
          "label": "Bucket Name",
          "type": "STRING",
          "required": true,
          "supportsExpression": true
        },
        {
          "key": "region",
          "label": "Region",
          "type": "STRING",
          "required": true,
          "defaultValue": "us-east-1",
          "supportsExpression": true
        },
        {
          "key": "key",
          "label": "File Key",
          "type": "STRING",
          "required": true,
          "supportsExpression": true
        },
        {
          "key": "body",
          "label": "File Content",
          "type": "TEXTAREA",
          "required": true,
          "supportsExpression": true
        }
      ],
      "inputScript": "return $inputs.body;",
      "outputPaths": []
    }
  ]
}