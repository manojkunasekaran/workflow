            "url": "https://example.com/wp-json/wp/v2/pages?per_page=50"
          },
          "detection": {
            "itemsPath": "$",
            "keyPaths": [
              "id"
            ]
          }
        }
      }
    },
    {
      "triggerId": "new_comments",
      "displayName": "New comments",
      "description": "Poll WordPress comments.",
      "triggerType": "POLL",
      "inputSchema": [],
      "preset": {
        "poll": {
          "semantics": "NEW_ITEMS",
          "http": {
            "method": "GET",
            "url": "https://example.com/wp-json/wp/v2/comments?per_page=50"
          },
          "detection": {
            "itemsPath": "$",
            "keyPaths": [
              "id"
            ]
          }
        }
      }
    }
  ]
}
