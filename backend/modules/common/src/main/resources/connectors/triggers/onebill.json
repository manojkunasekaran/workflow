{
  "connectorId": "onebill",
  "triggers": [
    {
      "triggerId": "new_subscribers",
      "displayName": "New subscribers",
      "description": "Poll for new subscribers.",
      "triggerType": "POLL",
      "inputSchema": [],
      "preset": {
        "poll": {
          "semantics": "NEW_ITEMS",
          "http": {
            "method": "GET",
            "url": "https://app.onebillsoftware.com/rest/SubscriberService/v1/subscribers?resultCount=100"
          },
          "detection": {
            "itemsPath": "$.subscribers",
            "keyPaths": [
              "accountNumber"
            ]
          }
        }
      }
    },
    {
      "triggerId": "new_invoices",
