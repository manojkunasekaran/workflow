    {
      "triggerId": "interaction_slash_command",
      "displayName": "Slash command used",
      "description": "Registers the interactions endpoint for slash commands.",
      "triggerType": "WEBHOOK",
      "inputSchema": [
        {
          "key": "application_id",
          "label": "Application ID",
          "type": "STRING",
          "required": true,
          "supportsExpression": false
        }
      ],
      "preset": {
        "webhook": {
          "subscribeHttp": {
            "method": "PATCH",
            "url": "https://discord.com/api/v10/applications/{application_id}",
            "body": "{\"interactions_endpoint_url\":\"{{callbackUrl}}\"}"
          },
          "unsubscribeHttp": {
            "method": "PATCH",
            "url": "https://discord.com/api/v10/applications/{application_id}",
            "body": "{\"interactions_endpoint_url\":null}"
          },
          "subscriptionIdPath": "$.id",
          "inbound": {
            "verificationMode": "NONE",
            "eventIdPath": "$.id",
            "ignoreDuplicates": true
          },
          "deliveryMode": "SUBSCRIBE"
        }
      }
    },
