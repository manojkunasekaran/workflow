{
  "connectorId": "discord",
  "triggers": [
    {
      "triggerId": "new_channel_messages",
      "displayName": "New channel messages",
      "description": "Triggers when new messages appear in a Discord channel.",
      "triggerType": "POLL",
      "inputSchema": [
        {
          "key": "channelId",
          "label": "Channel ID",
          "type": "STRING",
          "required": true,
          "supportsExpression": false
        }
      ],
      "preset": {
        "poll": {
          "semantics": "NEW_ITEMS",
          "http": {
            "method": "GET",
            "url": "https://discord.com/api/v10/channels/{channelId}/messages?limit=100"
          },
          "detection": {
            "keyPaths": [
              "id"
            ]
          }
        }
      }
    },
    {
      "triggerId": "updated_channel_messages",
      "displayName": "Updated channel messages",
      "description": "Triggers when existing messages are edited in a channel.",
      "triggerType": "POLL",
      "inputSchema": [
        {
          "key": "channelId",
          "label": "Channel ID",
          "type": "STRING",
          "required": true,
          "supportsExpression": false
        }
      ],
      "preset": {
        "poll": {
          "semantics": "UPDATED",
          "http": {
            "method": "GET",
            "url": "https://discord.com/api/v10/channels/{channelId}/messages?limit=100"
          },
          "detection": {
            "keyPaths": [
              "id"
            ],
            "updateKeyPath": "edited_timestamp"
          }
        }
      }
    },
    {
      "triggerId": "new_thread_messages",
      "displayName": "New thread messages",
      "description": "Triggers when new messages are posted in a thread.",
      "triggerType": "POLL",
      "inputSchema": [
        {
          "key": "channelId",
          "label": "Channel ID",
          "type": "STRING",
