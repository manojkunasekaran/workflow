{
  "connectorId": "telegram",
  "triggers": [
    {
      "triggerId": "new_updates",
      "displayName": "New bot updates",
      "description": "Polls Telegram for new updates (messages, callbacks, etc.).",
      "triggerType": "POLL",
      "inputSchema": [
        {
          "key": "token",
          "label": "Bot Token",
          "type": "STRING",
          "required": true,
          "supportsExpression": false
        }
      ],
      "preset": {
        "poll": {
          "semantics": "NEW_ITEMS",
          "http": {
            "method": "GET",
            "url": "https://api.telegram.org/bot{token}/getUpdates?limit=100"
          },
          "detection": {
            "itemsPath": "$.result",
            "keyPaths": [
              "update_id"
            ]
          }
        }
      }
    },
    {
      "triggerId": "new_messages_poll",
      "displayName": "New messages (poll)",
      "description": "Polls for new text messages only.",
      "triggerType": "POLL",
      "inputSchema": [
        {
          "key": "token",
          "label": "Bot Token",
          "type": "STRING",
          "required": true,
          "supportsExpression": false
        }
      ],
      "preset": {
        "poll": {
          "semantics": "NEW_ITEMS",
          "http": {
            "method": "GET",
            "url": "https://api.telegram.org/bot{token}/getUpdates?limit=100&allowed_updates=%5B%22message%22%5D"
          },
          "detection": {
            "itemsPath": "$.result",
            "keyPaths": [
              "update_id"
            ]
          }
        }
      }
    },
    {
      "triggerId": "message_received",
      "displayName": "Message received",
      "description": "Registers a webhook for new messages sent to the bot.",
      "triggerType": "WEBHOOK",
      "inputSchema": [
        {
          "key": "token",
          "label": "Bot Token",
          "type": "STRING",
          "required": true,
          "supportsExpression": false
        }
      ],
      "preset": {
        "webhook": {
          "subscribeHttp": {
            "method": "POST",
            "url": "https://api.telegram.org/bot{token}/setWebhook",
            "body": "{\"url\":\"{{callbackUrl}}\",\"secret_token\":\"{{secret}}\",\"allowed_updates\":[\"message\"]}"
          },
          "unsubscribeHttp": {
            "method": "POST",
            "url": "https://api.telegram.org/bot{token}/deleteWebhook",
            "body": "{}"
          },
          "subscriptionIdPath": "$.result",
          "inbound": {
            "verificationMode": "HEADER_SECRET",
            "headerName": "X-Telegram-Bot-Api-Secret-Token",
            "eventIdPath": "$.update_id",
            "ignoreDuplicates": true
          },
          "deliveryMode": "SUBSCRIBE"
        }
      }
    },
