{
  "connectorId": "jira",
  "triggers": [
    {
      "triggerId": "new_issues",
      "displayName": "New issues",
      "description": "Triggers when new issues are created in a project.",
      "triggerType": "POLL",
      "inputSchema": [
        {
          "key": "cloudId",
          "label": "Cloud ID",
          "type": "STRING",
          "required": true,
          "supportsExpression": false
        },
        {
          "key": "projectKey",
          "label": "Project Key",
          "type": "STRING",
          "required": true,
          "supportsExpression": false
        }
      ],
      "preset": {
        "poll": {
          "semantics": "NEW_ITEMS",
          "http": {
            "method": "POST",
            "url": "https://api.atlassian.com/ex/jira/{cloudId}/rest/api/3/search",
            "body": "{\"jql\":\"project = {projectKey} ORDER BY created DESC\",\"maxResults\":50,\"fields\":[\"summary\",\"status\",\"created\"]}"
          },
          "detection": {
            "itemsPath": "$.issues",
            "keyPaths": [
              "id"
            ]
          }
        }
      }
    },
    {
      "triggerId": "updated_issues",
      "displayName": "Updated issues",
      "description": "Triggers when issues are updated in a project.",
      "triggerType": "POLL",
      "inputSchema": [
        {
          "key": "cloudId",
          "label": "Cloud ID",
          "type": "STRING",
          "required": true,
          "supportsExpression": false
        },
        {
          "key": "projectKey",
          "label": "Project Key",
          "type": "STRING",
          "required": true,
          "supportsExpression": false
        }
      ],
      "preset": {
        "poll": {
          "semantics": "UPDATED",
          "http": {
            "method": "POST",
            "url": "https://api.atlassian.com/ex/jira/{cloudId}/rest/api/3/search",
            "body": "{\"jql\":\"project = {projectKey} ORDER BY updated DESC\",\"maxResults\":50,\"fields\":[\"summary\",\"status\",\"updated\"]}"
          },
          "detection": {
            "itemsPath": "$.issues",
            "keyPaths": [
              "id"
            ],
            "updateKeyPath": "fields.updated"
          }
        }
      }
    },
    {
      "triggerId": "new_comments",
      "displayName": "New comments",
      "description": "Triggers when new comments are added to issues.",
      "triggerType": "POLL",
      "inputSchema": [
        {
          "key": "cloudId",
          "label": "Cloud ID",
          "type": "STRING",
          "required": true,
          "supportsExpression": false
        },
        {
          "key": "issueIdOrKey",
          "label": "Issue ID or Key",
          "type": "STRING",
          "required": true,
          "supportsExpression": false
        }
      ],
      "preset": {
        "poll": {
          "semantics": "NEW_ITEMS",
          "http": {
            "method": "GET",
            "url": "https://api.atlassian.com/ex/jira/{cloudId}/rest/api/3/issue/{issueIdOrKey}/comment?maxResults=50&orderBy=-created"
          },
          "detection": {
            "itemsPath": "$.comments",
            "keyPaths": [
              "id"
            ]
          }
        }
      }
    },
