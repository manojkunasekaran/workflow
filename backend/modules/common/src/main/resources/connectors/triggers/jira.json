    {
      "triggerId": "issue_created",
      "displayName": "Issue created",
      "description": "Triggers when a new issue is created.",
      "triggerType": "WEBHOOK",
      "inputSchema": [
        {
          "key": "cloudId",
          "label": "Cloud ID",
          "type": "STRING",
          "required": true,
          "supportsExpression": false
        },
        {
          "key": "projectKey",
          "label": "Project Key",
          "type": "STRING",
          "required": true,
          "supportsExpression": false
        }
      ],
      "preset": {
        "webhook": {
          "subscribeHttp": {
            "method": "POST",
            "url": "https://api.atlassian.com/ex/jira/{cloudId}/rest/api/3/webhook",
            "body": "{\"url\":\"{{callbackUrl}}\",\"webhooks\":[{\"events\":[\"jira:issue_created\"],\"jqlFilter\":\"project = {projectKey}\"}]}"
          },
          "unsubscribeHttp": {
            "method": "DELETE",
            "url": "https://api.atlassian.com/ex/jira/{cloudId}/rest/api/3/webhook?webhookIds={{subscriptionId}}"
          },
          "subscriptionIdPath": "$.webhookRegistrationResult[0].createdWebhookId",
          "inbound": {
            "verificationMode": "NONE",
            "eventIdPath": "$.issue.id",
            "ignoreDuplicates": true
          },
          "deliveryMode": "SUBSCRIBE"
        }
      }
    },
