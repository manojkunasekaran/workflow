          "http": {
            "method": "GET",
            "url": "https://api.twilio.com/2010-04-01/Accounts/{AccountSid}/Messages.json?From={From}&PageSize=50"
          },
          "detection": {
            "itemsPath": "$.messages",
            "keyPaths": [
              "sid"
            ],
            "updateKeyPath": "status"
          }
        }
      }
    },
