{
  "connectorId": "twilio_sms",
  "triggers": [
    {
      "triggerId": "new_inbound_messages",
      "displayName": "New inbound SMS",
      "description": "Triggers when new SMS messages are received on a phone number.",
      "triggerType": "POLL",
      "inputSchema": [
        {
          "key": "AccountSid",
          "label": "Account SID",
          "type": "STRING",
          "required": true,
          "supportsExpression": false
        },
        {
          "key": "To",
          "label": "Phone Number (To)",
          "type": "STRING",
          "required": true,
          "supportsExpression": false
        }
      ],
      "preset": {
        "poll": {
          "semantics": "NEW_ITEMS",
          "http": {
            "method": "GET",
            "url": "https://api.twilio.com/2010-04-01/Accounts/{AccountSid}/Messages.json?To={To}&PageSize=50"
          },
          "detection": {
            "itemsPath": "$.messages",
            "keyPaths": [
              "sid"
            ]
          }
        }
      }
    },
    {
      "triggerId": "new_outbound_messages",
      "displayName": "New outbound SMS",
