    {
      "triggerId": "inbound_sms",
      "displayName": "Inbound SMS received",
      "description": "Registers an SMS webhook URL on a Twilio phone number.",
      "triggerType": "WEBHOOK",
      "inputSchema": [
        {
          "key": "AccountSid",
          "label": "Account SID",
          "type": "STRING",
          "required": true,
          "supportsExpression": false
        },
        {
          "key": "PhoneNumberSid",
          "label": "Phone Number SID",
          "type": "STRING",
          "required": true,
          "supportsExpression": false
        }
      ],
      "preset": {
        "webhook": {
          "subscribeHttp": {
            "method": "POST",
            "url": "https://api.twilio.com/2010-04-01/Accounts/{AccountSid}/IncomingPhoneNumbers/{PhoneNumberSid}.json",
            "body": "SmsUrl={{callbackUrl}}&SmsMethod=POST"
          },
          "unsubscribeHttp": {
            "method": "POST",
            "url": "https://api.twilio.com/2010-04-01/Accounts/{AccountSid}/IncomingPhoneNumbers/{PhoneNumberSid}.json",
            "body": "SmsUrl="
          },
          "subscriptionIdPath": "$.sid",
          "inbound": {
            "verificationMode": "NONE",
            "eventIdPath": "$.MessageSid",
            "ignoreDuplicates": true
          },
          "deliveryMode": "SUBSCRIBE"
        }
      }
    },
