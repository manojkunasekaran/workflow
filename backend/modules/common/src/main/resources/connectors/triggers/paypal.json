{
  "connectorId": "paypal",
  "triggers": [
    {
      "triggerId": "checkout_order_approved",
      "displayName": "Checkout order approved",
      "description": "Triggers when a buyer approves a checkout order.",
      "triggerType": "WEBHOOK",
      "inputSchema": [],
      "preset": {
        "webhook": {
          "subscribeHttp": {
            "method": "POST",
            "url": "https://api-m.paypal.com/v1/notifications/webhooks",
            "body": "{\"url\":\"{{callbackUrl}}\",\"event_types\":[{\"name\":\"CHECKOUT.ORDER.APPROVED\"}]}"
          },
          "unsubscribeHttp": {
            "method": "DELETE",
            "url": "https://api-m.paypal.com/v1/notifications/webhooks/{{subscriptionId}}"
          },
          "subscriptionIdPath": "$.id",
          "inbound": {
            "verificationMode": "HMAC_SHA256",
            "headerName": "PAYPAL-TRANSMISSION-SIG",
            "eventIdPath": "$.id",
            "ignoreDuplicates": true
          },
          "deliveryMode": "SUBSCRIBE"
        }
      }
    },
