    {
      "triggerId": "issue_opened",
      "displayName": "Issue opened",
      "description": "Triggers when an issue is opened in a repository.",
      "triggerType": "WEBHOOK",
      "inputSchema": [
        {
          "key": "owner",
          "label": "Owner",
          "type": "STRING",
          "required": true,
          "supportsExpression": false
        },
        {
          "key": "repo",
          "label": "Repository",
          "type": "STRING",
          "required": true,
          "supportsExpression": false
        }
      ],
      "preset": {
        "webhook": {
          "subscribeHttp": {
            "method": "POST",
            "url": "https://api.github.com/repos/{owner}/{repo}/hooks",
            "body": "{\"name\":\"web\",\"active\":true,\"events\":[\"issues\"],\"config\":{\"url\":\"{{callbackUrl}}\",\"content_type\":\"json\",\"secret\":\"{{secret}}\"}}"
          },
          "unsubscribeHttp": {
            "method": "DELETE",
            "url": "https://api.github.com/repos/{owner}/{repo}/hooks/{{subscriptionId}}"
          },
          "subscriptionIdPath": "$.id",
          "inbound": {
            "verificationMode": "HMAC_SHA256",
            "headerName": "X-Hub-Signature-256",
            "eventIdPath": "$.id",
            "ignoreDuplicates": true
          },
          "deliveryMode": "SUBSCRIBE"
        }
      }
    },
