{
  "connectorId": "github",
  "triggers": [
    {
      "triggerId": "new_issues",
      "displayName": "New issues",
      "description": "Triggers when new open issues appear in a repository.",
      "triggerType": "POLL",
      "inputSchema": [
        {
          "key": "owner",
          "label": "Owner",
          "type": "STRING",
          "required": true,
          "supportsExpression": false
        },
        {
          "key": "repo",
          "label": "Repository",
          "type": "STRING",
          "required": true,
          "supportsExpression": false
        }
      ],
      "preset": {
        "poll": {
          "semantics": "NEW_ITEMS",
          "http": {
            "method": "GET",
            "url": "https://api.github.com/repos/{owner}/{repo}/issues?state=open&per_page=100"
          },
          "detection": {
            "keyPaths": [
              "id"
            ]
          }
        }
      }
    },
    {
      "triggerId": "new_pull_requests",
