          }
        }
      }
    },
    {
      "triggerId": "issue_created",
      "displayName": "Issue created",
      "description": "Triggers when a new issue is created.",
      "triggerType": "WEBHOOK",
      "inputSchema": [
        {
          "key": "teamId",
          "label": "Team ID",
          "type": "STRING",
          "required": true,
          "supportsExpression": false
        }
      ],
      "preset": {
        "webhook": {
          "subscribeHttp": {
            "method": "POST",
            "url": "https://api.linear.app/graphql",
            "body": "{\"query\":\"mutation { webhookCreate(input: { url: \\\"{{callbackUrl}}\\\", resourceTypes: [\\\"Issue\\\"], teamId: \\\"{teamId}\\\", label: \\\"workflow-trigger\\\" }) { webhook { id } success } }\"}"
          },
          "unsubscribeHttp": {
            "method": "POST",
            "url": "https://api.linear.app/graphql",
            "body": "{\"query\":\"mutation { webhookDelete(id: \\\"{{subscriptionId}}\\\") { success } }\"}"
          },
          "subscriptionIdPath": "$.data.webhookCreate.webhook.id",
          "inbound": {
            "verificationMode": "HMAC_SHA256",
            "headerName": "Linear-Signature",
            "eventIdPath": "$.data.id",
            "ignoreDuplicates": true
          },
          "deliveryMode": "SUBSCRIBE"
        }
      }
    },
