          },
          "detection": {
            "itemsPath": "$.data.team.projects.nodes",
            "keyPaths": [
              "id"
            ]
          }
        }
      }
    },
    {
      "triggerId": "new_comments",
      "displayName": "New comments",
      "description": "Triggers when new comments are added to issues.",
      "triggerType": "POLL",
      "inputSchema": [
        {
          "key": "issueId",
          "label": "Issue ID",
          "type": "STRING",
          "required": true,
          "supportsExpression": false
        }
      ],
      "preset": {
        "poll": {
          "semantics": "NEW_ITEMS",
          "http": {
            "method": "POST",
            "url": "https://api.linear.app/graphql",
            "body": "{\"query\":\"query { issue(id: \\\"{issueId}\\\") { comments { nodes { id createdAt } } } }\"}"
          },
          "detection": {
            "itemsPath": "$.data.issue.comments.nodes",
            "keyPaths": [
              "id"
            ]
          }
        }
      }
    },
    {
      "triggerId": "new_cycles",
