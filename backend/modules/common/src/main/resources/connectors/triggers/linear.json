{
  "connectorId": "linear",
  "triggers": [
    {
      "triggerId": "new_issues",
      "displayName": "New issues",
      "description": "Triggers when new issues are created in a team.",
      "triggerType": "POLL",
      "inputSchema": [
        {
          "key": "teamId",
          "label": "Team ID",
          "type": "STRING",
          "required": true,
          "supportsExpression": false
        }
      ],
      "preset": {
        "poll": {
          "semantics": "NEW_ITEMS",
          "http": {
            "method": "POST",
            "url": "https://api.linear.app/graphql",
            "body": "{\"query\":\"query { issues(filter: { team: { id: { eq: \\\"{teamId}\\\" } } }, first: 50, orderBy: updatedAt) { nodes { id updatedAt } } }\"}"
          },
          "detection": {
            "itemsPath": "$.data.issues.nodes",
            "keyPaths": [
              "id"
            ]
          }
        }
      }
    },
    {
      "triggerId": "updated_issues",
      "displayName": "Updated issues",
      "description": "Triggers when issues are updated in a team.",
      "triggerType": "POLL",
      "inputSchema": [
        {
          "key": "teamId",
          "label": "Team ID",
          "type": "STRING",
          "required": true,
          "supportsExpression": false
        }
      ],
      "preset": {
        "poll": {
          "semantics": "UPDATED",
          "http": {
            "method": "POST",
            "url": "https://api.linear.app/graphql",
            "body": "{\"query\":\"query { issues(filter: { team: { id: { eq: \\\"{teamId}\\\" } } }, first: 50, orderBy: updatedAt) { nodes { id updatedAt } } }\"}"
          },
          "detection": {
            "itemsPath": "$.data.issues.nodes",
            "keyPaths": [
              "id"
            ],
            "updateKeyPath": "updatedAt"
          }
        }
      }
    },
    {
      "triggerId": "new_projects",
      "displayName": "New projects",
