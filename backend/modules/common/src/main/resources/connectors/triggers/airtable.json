            "body": "{\"notificationUrl\":\"{{callbackUrl}}\",\"specification\":{\"options\":{\"filters\":{\"dataTypes\":[\"tableData\",\"comment\"],\"recordChangeScope\":\"{tableId}\"}}}}"
          },
          "unsubscribeHttp": {
            "method": "DELETE",
            "url": "https://api.airtable.com/v0/bases/{baseId}/webhooks/{{subscriptionId}}"
          },
          "subscriptionIdPath": "$.id",
