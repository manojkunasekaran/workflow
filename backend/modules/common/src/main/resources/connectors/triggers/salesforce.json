{
  "connectorId": "salesforce",
  "triggers": [
    {
      "triggerId": "new_leads",
      "displayName": "New leads",
      "description": "Triggers when new leads are created.",
      "triggerType": "POLL",
      "inputSchema": [
        {"key": "instance_url", "label": "Instance URL", "type": "STRING", "required": true, "supportsExpression": false}
      ],
      "preset": {
        "poll": {
          "semantics": "NEW_ITEMS",
          "http": {"method": "GET", "url": "https://{instance_url}/services/data/v60.0/query?q=SELECT+Id,CreatedDate,LastName,Company+FROM+Lead+ORDER+BY+CreatedDate+DESC+LIMIT+100"},
          "detection": {"itemsPath": "$.records", "keyPaths": ["Id"]}
        }
      }
    },
