{
  "connectorId": "asana",
  "triggers": [
    {
      "triggerId": "new_tasks",
      "displayName": "New tasks",
      "description": "Poll tasks in a project.",
      "triggerType": "POLL",
      "inputSchema": [
        {
          "key": "projectGid",
          "label": "Project GID",
          "type": "STRING",
          "required": true,
          "supportsExpression": false
        }
      ],
      "preset": {
        "poll": {
          "semantics": "NEW_ITEMS",
          "http": {
            "method": "GET",
            "url": "https://app.asana.com/api/1.0/tasks?project={projectGid}&limit=100"
          },
          "detection": {
            "itemsPath": "$.data",
            "keyPaths": [
              "gid"
            ]
          }
        }
      }
    },
    {
      "triggerId": "updated_tasks",
      "displayName": "Updated tasks",
      "description": "Poll updated tasks in a project.",
      "triggerType": "POLL",
      "inputSchema": [
        {
          "key": "projectGid",
          "label": "Project GID",
          "type": "STRING",
          "required": true,
          "supportsExpression": false
        }
      ],
      "preset": {
        "poll": {
          "semantics": "UPDATED",
          "http": {
            "method": "GET",
            "url": "https://app.asana.com/api/1.0/tasks?project={projectGid}&limit=100"
          },
          "detection": {
            "itemsPath": "$.data",
            "keyPaths": [
              "gid"
            ],
            "updateKeyPath": "modified_at"
          }
        }
      }
    },
    {
      "triggerId": "new_projects",
      "displayName": "New projects",
      "description": "Poll projects in a workspace.",
      "triggerType": "POLL",
      "inputSchema": [
        {
          "key": "workspaceGid",
          "label": "Workspace GID",
          "type": "STRING",
          "required": true,
          "supportsExpression": false
        }
      ],
      "preset": {
        "poll": {
          "semantics": "NEW_ITEMS",
          "http": {
            "method": "GET",
            "url": "https://app.asana.com/api/1.0/projects?workspace={workspaceGid}&limit=100"
          },
          "detection": {
            "itemsPath": "$.data",
            "keyPaths": [
              "gid"
            ]
          }
        }
      }
    },
    {
      "triggerId": "new_stories",
      "displayName": "New stories",
      "description": "Poll comments (stories) on a task.",
      "triggerType": "POLL",
      "inputSchema": [
        {
          "key": "taskGid",
          "label": "Task GID",
          "type": "STRING",
          "required": true,
          "supportsExpression": false
        }
      ],
      "preset": {
        "poll": {
          "semantics": "NEW_ITEMS",
          "http": {
            "method": "GET",
            "url": "https://app.asana.com/api/1.0/tasks/{taskGid}/stories?limit=100"
          },
          "detection": {
            "itemsPath": "$.data",
            "keyPaths": [
              "gid"
            ]
          }
        }
      }
    }
  ]
}
