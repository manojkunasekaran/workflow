{
  "connectorId": "hubspot",
  "triggers": [
    {
      "triggerId": "new_contacts",
      "displayName": "New contacts",
      "description": "Triggers when new contacts are created.",
      "triggerType": "POLL",
      "inputSchema": [],
      "preset": {
        "poll": {
          "semantics": "NEW_ITEMS",
          "http": {
            "method": "GET",
            "url": "https://api.hubapi.com/crm/v3/objects/contacts?limit=100&properties=email,firstname,lastname,createdate"
          },
          "detection": {
            "itemsPath": "$.results",
            "keyPaths": [
              "id"
            ]
          }
        }
      }
    },
