    {
      "triggerId": "contact_created",
      "displayName": "Contact created",
      "description": "Triggers when a contact is created.",
      "triggerType": "WEBHOOK",
      "inputSchema": [
        {
          "key": "appId",
          "label": "App ID",
          "type": "STRING",
          "required": true,
          "supportsExpression": false
        }
      ],
      "preset": {
        "webhook": {
          "subscribeHttp": {
            "method": "POST",
            "url": "https://api.hubapi.com/webhooks/v3/{appId}/subscriptions",
            "body": "{\"eventType\":\"contact.creation\",\"active\":true}"
          },
          "unsubscribeHttp": {
            "method": "DELETE",
            "url": "https://api.hubapi.com/webhooks/v3/{appId}/subscriptions/{{subscriptionId}}"
          },
          "subscriptionIdPath": "$.id",
          "inbound": {
            "verificationMode": "HMAC_SHA256",
            "headerName": "X-HubSpot-Signature-v3",
            "eventIdPath": "$.objectId",
            "ignoreDuplicates": true
          },
          "deliveryMode": "SUBSCRIBE"
        }
      }
    },
