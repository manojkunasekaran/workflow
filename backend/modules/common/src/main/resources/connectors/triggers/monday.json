    },
    {
      "triggerId": "item_created",
      "displayName": "Item created",
      "description": "Triggers when a new item is created on a board.",
      "triggerType": "WEBHOOK",
      "inputSchema": [
        {
          "key": "boardId",
          "label": "Board ID",
          "type": "STRING",
          "required": true,
          "supportsExpression": false
        }
      ],
      "preset": {
        "webhook": {
          "subscribeHttp": {
            "method": "POST",
            "url": "https://api.monday.com/v2",
            "body": "{\"query\":\"mutation { create_webhook(board_id: {boardId}, url: \\\"{{callbackUrl}}\\\", event: create_item) { id } }\"}"
          },
          "unsubscribeHttp": {
            "method": "POST",
            "url": "https://api.monday.com/v2",
            "body": "{\"query\":\"mutation { delete_webhook(id: {{subscriptionId}}) { id } }\"}"
          },
          "subscriptionIdPath": "$.data.create_webhook.id",
          "inbound": {
            "verificationMode": "HEADER_SECRET",
            "headerName": "Authorization",
            "eventIdPath": "$.event.triggerUuid",
            "ignoreDuplicates": true
          },
          "deliveryMode": "SUBSCRIBE"
        }
      }
    },
