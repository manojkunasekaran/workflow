{
  "connectorId": "monday",
  "triggers": [
    {
      "triggerId": "new_items",
      "displayName": "New items",
      "description": "Triggers when new items are created on a board.",
      "triggerType": "POLL",
      "inputSchema": [
        {
          "key": "boardId",
          "label": "Board ID",
          "type": "STRING",
          "required": true,
          "supportsExpression": false
        }
      ],
      "preset": {
        "poll": {
          "semantics": "NEW_ITEMS",
          "http": {
            "method": "POST",
            "url": "https://api.monday.com/v2",
            "body": "{\"query\":\"query { boards(ids: [{boardId}]) { items_page(limit: 50) { items { id updated_at } } } }\"}"
          },
          "detection": {
            "itemsPath": "$.data.boards[0].items_page.items",
            "keyPaths": [
              "id"
            ]
          }
        }
      }
    },
    {
      "triggerId": "updated_items",
      "displayName": "Updated items",
      "description": "Triggers when items are updated on a board.",
      "triggerType": "POLL",
      "inputSchema": [
        {
          "key": "boardId",
          "label": "Board ID",
          "type": "STRING",
          "required": true,
          "supportsExpression": false
        }
      ],
      "preset": {
        "poll": {
          "semantics": "UPDATED",
          "http": {
            "method": "POST",
            "url": "https://api.monday.com/v2",
            "body": "{\"query\":\"query { boards(ids: [{boardId}]) { items_page(limit: 50) { items { id updated_at } } } }\"}"
          },
          "detection": {
            "itemsPath": "$.data.boards[0].items_page.items",
            "keyPaths": [
              "id"
            ],
            "updateKeyPath": "updated_at"
          }
        }
      }
    },
    {
      "triggerId": "new_updates",
