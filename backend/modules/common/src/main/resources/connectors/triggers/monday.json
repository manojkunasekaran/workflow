            "method": "POST",
            "url": "https://api.monday.com/v2",
            "body": "{\"query\":\"query { items(ids: [{itemId}]) { updates { id created_at } } }\"}"
          },
          "detection": {
            "itemsPath": "$.data.items[0].updates",
            "keyPaths": [
              "id"
            ]
          }
        }
      }
    },
