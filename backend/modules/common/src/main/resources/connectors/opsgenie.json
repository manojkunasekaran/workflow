{
    "connectorId": "opsgenie",
    "displayName": "Opsgenie",
    "icon": "https://api.iconify.design/logos/opsgenie.svg",
    "category": "Incident Management",
    "taskType": "CONNECTOR_TASK",
    "baseUrl": "https://api.opsgenie.com/v2",
    "authType": "CUSTOM_HEADER",
    "actions": [
        {
            "actionId": "list_alerts",
            "displayName": "List Alerts",
            "method": "GET",
            "path": "/alerts",
            "inputSchema": [
                {
                    "key": "limit",
                    "label": "Limit",
                    "type": "NUMBER",
                    "required": false,
                    "supportsExpression": true,
                    "defaultValue": 20
                }
            ],
            "outputPaths": [
                "data"
            ]
        },
        {
            "actionId": "get_alert",
            "displayName": "Get Alert",
            "method": "GET",
            "path": "/alerts/{identifier}",
            "inputSchema": [
                {
                    "key": "identifier",
                    "label": "Alert ID or Alias",
                    "type": "STRING",
                    "required": true,
                    "supportsExpression": true
                }
            ],
            "pathParams": [
                "identifier"
            ],
            "outputPaths": [
                "data"
            ]
        },
        {
            "actionId": "create_alert",
            "displayName": "Create Alert",
            "method": "POST",
            "path": "/alerts",
            "inputSchema": [
                {
                    "key": "message",
                    "label": "Message",
                    "type": "STRING",
                    "required": true,
                    "supportsExpression": true
                },
                {
                    "key": "alias",
                    "label": "Alias",
                    "type": "STRING",
                    "required": false,
                    "supportsExpression": true
                },
                {
                    "key": "description",
                    "label": "Description",
                    "type": "TEXTAREA",
                    "required": false,
                    "supportsExpression": true
                }
            ],
            "inputScript": "const b={message:$inputs.message}; if($inputs.alias) b.alias=$inputs.alias; if($inputs.description) b.description=$inputs.description; return b;",
            "fixedHeaders": {
                "Content-Type": "application/json"
            },
            "outputPaths": [
                "requestId"
            ]
        },
        {
            "actionId": "close_alert",
            "displayName": "Close Alert",
            "method": "POST",
            "path": "/alerts/{identifier}/close",
            "inputSchema": [
                {
                    "key": "identifier",
                    "label": "Alert ID or Alias",
                    "type": "STRING",
                    "required": true,
                    "supportsExpression": true
                },
                {
                    "key": "note",
                    "label": "Note",
                    "type": "STRING",
                    "required": false,
                    "supportsExpression": true
                }
            ],
            "pathParams": [
                "identifier"
            ],
            "inputScript": "return $inputs.note?{note:$inputs.note}:{};",
            "fixedHeaders": {
                "Content-Type": "application/json"
            },
            "outputPaths": [
                "result"
            ]
        },
        {
            "actionId": "acknowledge_alert",
            "displayName": "Acknowledge Alert",
            "method": "POST",
            "path": "/alerts/{identifier}/acknowledge",
            "inputSchema": [
                {
                    "key": "identifier",
                    "label": "Alert ID or Alias",
                    "type": "STRING",
                    "required": true,
                    "supportsExpression": true
                }
            ],
            "pathParams": [
                "identifier"
            ],
            "outputPaths": [
                "result"
            ]
        },
        {
