        {
            "actionId": "create_incident",
            "displayName": "Create Incident",
            "method": "POST",
            "path": "/incidents",
            "inputSchema": [
                {
                    "key": "message",
                    "label": "Message",
                    "type": "STRING",
                    "required": true,
                    "supportsExpression": true
                },
                {
                    "key": "priority",
                    "label": "Priority",
                    "type": "STRING",
                    "required": false,
                    "supportsExpression": true,
                    "defaultValue": "P3"
                }
            ],
            "inputScript": "return {message:$inputs.message,priority:$inputs.priority||'P3'};",
            "fixedHeaders": {
                "Content-Type": "application/json"
            },
            "outputPaths": [
                "incidentId"
            ]
        },
        {
            "actionId": "close_incident",
