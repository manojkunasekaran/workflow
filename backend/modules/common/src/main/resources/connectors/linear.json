            },
            "outputPaths": [
                "data.issueSearch.nodes"
            ]
        },
        {
            "actionId": "get_viewer",
            "displayName": "Get Viewer",
            "method": "POST",
            "path": "",
            "inputSchema": [],
            "inputScript": "return { query: `query { viewer { id name email } }` };",
            "fixedHeaders": {
