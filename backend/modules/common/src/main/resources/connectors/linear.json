            "inputScript": "return { query: `mutation { issueUpdate(id: \"${$inputs.issueId}\", input: { assigneeId: \"${$inputs.assigneeId}\" }) { issue { id } } }` };",
            "fixedHeaders": {
                "Content-Type": "application/json"
            },
            "outputPaths": [
