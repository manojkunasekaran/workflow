            "inputSchema": [
                {
                    "key": "teamId",
                    "label": "Team ID",
                    "type": "STRING",
                    "required": true,
                    "supportsExpression": true
                }
            ],
            "inputScript": "return { query: `query { team(id: \"${$inputs.teamId}\") { states { nodes { id name type } } } }` };",
