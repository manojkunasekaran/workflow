    ],
    "connectionSetup": {
        "fields": [
            {
                "label": "API Key",
                "key": "token",
                "sensitive": true,
                "hint": "Found in Linear settings under API"
            }
        ]
    },
    "verifyAction": {
        "method": "POST",
        "path": ""
    }
}
