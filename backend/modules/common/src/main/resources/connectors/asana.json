{
    "connectorId": "asana",
    "displayName": "Asana",
    "icon": "https://api.iconify.design/logos/asana.svg",
    "category": "Project Management",
    "taskType": "CONNECTOR_TASK",
    "baseUrl": "https://app.asana.com/api/1.0",
    "authType": "BEARER_TOKEN",
    "credentialGuide": {
        "description": "Create a Personal Access Token in Asana developer settings.",
        "fields": [
            {
                "key": "token",
                "label": "Personal Access Token",
                "hint": "Asana My Settings \u2192 Apps \u2192 Manage Developer Apps \u2192 Personal access tokens",
                "docUrl": "https://developers.asana.com/docs/personal-access-token"
            }
        ]
    },
    "connectionSetup": {
        "fields": [
            {
                "label": "Personal Access Token",
                "key": "token",
                "sensitive": true
            }
        ]
    },
    "verifyAction": {
        "method": "GET",
        "path": "/users/me"
    },
    "actions": [
        {
            "actionId": "list_tasks",
            "displayName": "List Tasks",
            "method": "GET",
            "path": "/tasks",
            "inputSchema": [
                {
                    "key": "project",
                    "label": "Project GID",
                    "type": "STRING",
                    "required": false,
                    "supportsExpression": true
                },
                {
                    "key": "assignee",
                    "label": "Assignee GID",
                    "type": "STRING",
                    "required": false,
                    "supportsExpression": true
                },
                {
                    "key": "limit",
                    "label": "Limit",
                    "type": "NUMBER",
                    "required": false,
                    "supportsExpression": true,
                    "defaultValue": 100
                }
            ],
            "outputPaths": [
                "data"
            ]
        },
        {
            "actionId": "get_task",
            "displayName": "Get Task",
            "method": "GET",
            "path": "/tasks/{taskGid}",
            "inputSchema": [
                {
                    "key": "taskGid",
                    "label": "Task GID",
                    "type": "STRING",
                    "required": true,
                    "supportsExpression": true
                }
            ],
            "pathParams": [
                "taskGid"
            ],
            "outputPaths": [
                "data"
            ]
        },
        {
            "actionId": "create_task",
            "displayName": "Create Task",
            "method": "POST",
            "path": "/tasks",
            "inputSchema": [
                {
                    "key": "name",
                    "label": "Name",
                    "type": "STRING",
                    "required": true,
                    "supportsExpression": true
                },
                {
                    "key": "projects",
                    "label": "Project GIDs (comma-separated)",
                    "type": "STRING",
                    "required": false,
                    "supportsExpression": true
                },
                {
                    "key": "notes",
                    "label": "Notes",
                    "type": "TEXTAREA",
                    "required": false,
                    "supportsExpression": true
                }
            ],
            "inputScript": "const d={name:$inputs.name}; if($inputs.notes) d.notes=$inputs.notes; if($inputs.projects) d.projects=$inputs.projects.split(',').map(s=>s.trim()); return {data:d};",
            "fixedHeaders": {
                "Content-Type": "application/json"
            },
            "outputPaths": [
                "data.gid"
            ]
        },
        {
            "actionId": "update_task",
            "displayName": "Update Task",
            "method": "PUT",
            "path": "/tasks/{taskGid}",
            "inputSchema": [
                {
                    "key": "taskGid",
                    "label": "Task GID",
                    "type": "STRING",
                    "required": true,
                    "supportsExpression": true
                },
                {
                    "key": "name",
                    "label": "Name",
                    "type": "STRING",
                    "required": false,
                    "supportsExpression": true
                },
                {
                    "key": "completed",
                    "label": "Completed",
                    "type": "BOOLEAN",
                    "required": false,
                    "supportsExpression": true
                },
                {
                    "key": "notes",
                    "label": "Notes",
                    "type": "TEXTAREA",
                    "required": false,
                    "supportsExpression": true
                }
            ],
            "pathParams": [
                "taskGid"
            ],
            "inputScript": "const d={}; if($inputs.name) d.name=$inputs.name; if($inputs.completed!=null) d.completed=$inputs.completed; if($inputs.notes!=null) d.notes=$inputs.notes; return {data:d};",
            "fixedHeaders": {
                "Content-Type": "application/json"
            },
            "outputPaths": [
                "data.gid"
            ]
        },
        {
            "actionId": "delete_task",
            "displayName": "Delete Task",
            "method": "DELETE",
            "path": "/tasks/{taskGid}",
            "inputSchema": [
                {
                    "key": "taskGid",
                    "label": "Task GID",
                    "type": "STRING",
                    "required": true,
                    "supportsExpression": true
                }
            ],
            "pathParams": [
                "taskGid"
            ],
            "outputPaths": [
                "data"
            ]
        },
