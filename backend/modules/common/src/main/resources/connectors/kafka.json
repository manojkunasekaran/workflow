                "$"
            ]
        },
        {
            "actionId": "get_topic",
            "displayName": "Get Topic",
            "method": "GET",
            "path": "/topics/{topic}",
            "inputSchema": [
                {
                    "key": "topic",
                    "label": "Topic Name",
                    "type": "STRING",
                    "required": true,
                    "supportsExpression": true
                }
            ],
            "pathParams": [
                "topic"
            ],
            "outputPaths": [
                "$"
            ]
        },
        {
            "actionId": "create_topic",
            "displayName": "Create Topic",
            "method": "POST",
            "path": "/topics/{topic}",
            "inputSchema": [
                {
                    "key": "topic",
                    "label": "Topic Name",
                    "type": "STRING",
                    "required": true,
                    "supportsExpression": true
                }
            ],
            "pathParams": [
                "topic"
            ],
            "inputScript": "return {};",
            "fixedHeaders": {
                "Content-Type": "application/json"
            },
            "outputPaths": [
                "$"
            ]
        },
        {
            "actionId": "delete_topic",
            "displayName": "Delete Topic",
            "method": "DELETE",
            "path": "/topics/{topic}",
            "inputSchema": [
                {
                    "key": "topic",
                    "label": "Topic Name",
                    "type": "STRING",
                    "required": true,
                    "supportsExpression": true
                }
            ],
            "pathParams": [
                "topic"
            ],
            "outputPaths": [
                "$"
            ]
        },
        {
            "actionId": "produce_record",
            "displayName": "Produce Record",
            "method": "POST",
            "path": "/topics/{topic}",
            "inputSchema": [
                {
                    "key": "topic",
                    "label": "Topic Name",
                    "type": "STRING",
                    "required": true,
                    "supportsExpression": true
                },
                {
                    "key": "key",
                    "label": "Key",
                    "type": "STRING",
                    "required": false,
                    "supportsExpression": true
                },
                {
                    "key": "value",
                    "label": "Value",
                    "type": "TEXTAREA",
                    "required": true,
                    "supportsExpression": true
                }
            ],
            "pathParams": [
                "topic"
            ],
            "inputScript": "return {records:[{key:$inputs.key||null,value:$inputs.value}]};",
            "fixedHeaders": {
                "Content-Type": "application/json"
            },
            "outputPaths": [
                "offsets"
            ]
        },
        {
            "actionId": "produce_record_v2",
            "displayName": "Produce Record (Confluent v2)",
            "method": "POST",
            "path": "/topics/{topic}/records",
            "inputSchema": [
                {
                    "key": "topic",
                    "label": "Topic Name",
                    "type": "STRING",
                    "required": true,
                    "supportsExpression": true
                },
                {
                    "key": "value",
                    "label": "Value",
                    "type": "TEXTAREA",
                    "required": true,
                    "supportsExpression": true
                }
            ],
            "pathParams": [
                "topic"
            ],
            "inputScript": "return {value:{type:'JSON',data:$inputs.value}};",
            "fixedHeaders": {
                "Content-Type": "application/json"
            },
            "outputPaths": [
                "$"
            ]
        },
        {
            "actionId": "get_partitions",
            "displayName": "Get Topic Partitions",
