        {
            "actionId": "produce_with_headers",
            "displayName": "Produce With Headers",
            "method": "POST",
            "path": "/topics/{topic}",
            "inputSchema": [
                {
                    "key": "topic",
                    "label": "Topic Name",
                    "type": "STRING",
                    "required": true,
                    "supportsExpression": true
                },
                {
                    "key": "value",
                    "label": "Value",
                    "type": "TEXTAREA",
                    "required": true,
                    "supportsExpression": true
                },
                {
                    "key": "header_key",
                    "label": "Header Key",
                    "type": "STRING",
                    "required": false,
                    "supportsExpression": true
                }
            ],
            "pathParams": [
                "topic"
            ],
            "inputScript": "const r={value:$inputs.value}; if($inputs.header_key) r.headers=[{key:$inputs.header_key,value:'1'}]; return {records:[r]};",
            "fixedHeaders": {
                "Content-Type": "application/json"
            },
            "outputPaths": [
                "offsets"
            ]
        }
