            "actionId": "create_event",
            "displayName": "Create Event",
            "method": "POST",
            "path": "/events",
            "inputSchema": [
                {
                    "key": "metric_name",
                    "label": "Metric Name",
                    "type": "STRING",
                    "required": true,
                    "supportsExpression": true
                },
                {
                    "key": "profile_email",
                    "label": "Profile Email",
                    "type": "STRING",
                    "required": true,
                    "supportsExpression": true
                },
                {
                    "key": "properties",
                    "label": "Properties JSON",
                    "type": "JSON",
                    "required": false,
                    "supportsExpression": true
                }
            ],
            "inputScript": "const p=$inputs.properties?(typeof $inputs.properties==='string'?JSON.parse($inputs.properties):$inputs.properties):{}; return {data:{type:'event',attributes:{metric:{data:{type:'metric',attributes:{name:$inputs.metric_name}}},profile:{data:{type:'profile',attributes:{email:$inputs.profile_email}}},properties:p}}};",
            "fixedHeaders": {
                "Content-Type": "application/json"
            },
            "outputPaths": [
                "data"
            ]
