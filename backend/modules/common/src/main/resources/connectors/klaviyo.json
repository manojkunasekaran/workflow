{
    "connectorId": "klaviyo",
    "displayName": "Klaviyo",
    "icon": "https://www.google.com/s2/favicons?domain=klaviyo.com&sz=128",
    "category": "Marketing",
    "taskType": "CONNECTOR_TASK",
    "baseUrl": "https://a.klaviyo.com/api",
    "authType": "CUSTOM_HEADER",
    "actions": [
        {
            "actionId": "list_profiles",
            "displayName": "List Profiles",
            "method": "GET",
            "path": "/profiles",
            "inputSchema": [
                {
                    "key": "page_size",
                    "label": "Page Size",
                    "type": "NUMBER",
                    "required": false,
                    "supportsExpression": true,
                    "defaultValue": 50
                }
            ],
            "outputPaths": [
                "data"
            ]
        },
        {
            "actionId": "get_profile",
            "displayName": "Get Profile",
            "method": "GET",
            "path": "/profiles/{profile_id}",
            "inputSchema": [
                {
                    "key": "profile_id",
                    "label": "Profile ID",
                    "type": "STRING",
                    "required": true,
                    "supportsExpression": true
                }
            ],
            "pathParams": [
                "profile_id"
            ],
            "outputPaths": [
                "data"
            ]
        },
        {
            "actionId": "create_profile",
            "displayName": "Create Profile",
            "method": "POST",
            "path": "/profiles",
            "inputSchema": [
                {
                    "key": "email",
                    "label": "Email",
                    "type": "STRING",
                    "required": true,
                    "supportsExpression": true
                },
                {
                    "key": "first_name",
                    "label": "First Name",
                    "type": "STRING",
                    "required": false,
                    "supportsExpression": true
                },
                {
                    "key": "last_name",
                    "label": "Last Name",
                    "type": "STRING",
                    "required": false,
                    "supportsExpression": true
                }
            ],
            "inputScript": "return {data:{type:'profile',attributes:{email:$inputs.email,first_name:$inputs.first_name,last_name:$inputs.last_name}}};",
            "fixedHeaders": {
                "Content-Type": "application/json"
            },
            "outputPaths": [
                "data"
            ]
        },
        {
            "actionId": "update_profile",
            "displayName": "Update Profile",
            "method": "PATCH",
            "path": "/profiles/{profile_id}",
            "inputSchema": [
                {
                    "key": "profile_id",
                    "label": "Profile ID",
                    "type": "STRING",
                    "required": true,
                    "supportsExpression": true
                },
                {
                    "key": "first_name",
                    "label": "First Name",
                    "type": "STRING",
                    "required": false,
                    "supportsExpression": true
                },
                {
                    "key": "last_name",
                    "label": "Last Name",
                    "type": "STRING",
                    "required": false,
                    "supportsExpression": true
                }
            ],
            "pathParams": [
                "profile_id"
            ],
            "inputScript": "const a={}; if($inputs.first_name) a.first_name=$inputs.first_name; if($inputs.last_name) a.last_name=$inputs.last_name; return {data:{type:'profile',id:$inputs.profile_id,attributes:a}};",
            "fixedHeaders": {
                "Content-Type": "application/json"
            },
            "outputPaths": [
                "data"
            ]
        },
        {
            "actionId": "list_lists",
