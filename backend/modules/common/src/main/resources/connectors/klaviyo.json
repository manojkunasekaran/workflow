        {
            "actionId": "add_profile_to_list",
            "displayName": "Add Profile to List",
            "method": "POST",
            "path": "/lists/{list_id}/relationships/profiles",
            "inputSchema": [
                {
                    "key": "list_id",
                    "label": "List ID",
                    "type": "STRING",
                    "required": true,
                    "supportsExpression": true
                },
                {
                    "key": "profile_id",
                    "label": "Profile ID",
                    "type": "STRING",
                    "required": true,
                    "supportsExpression": true
                }
            ],
            "pathParams": [
                "list_id"
            ],
            "inputScript": "return {data:[{type:'profile',id:$inputs.profile_id}]};",
            "fixedHeaders": {
                "Content-Type": "application/json"
            },
            "outputPaths": [
                "$"
            ]
        },
